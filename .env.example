# Copy this file to .env.local (git ignores it) and fill in the values.
# Every value comes from YOUR Supabase project: Dashboard > Project Settings.
# Never commit .env.local, and never paste these values into chat.

# --- server only (FastAPI) --------------------------------------------------
# Connect > Session pooler (port 5432), NOT the transaction pooler (6543).
# Looks like: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Project Settings > Data API > Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Project Settings > API Keys > Secret key (sb_secret_...). Full access to your
# project: server only, never in the frontend, never in a VITE_ variable.
SUPABASE_SECRET_KEY=

# --- browser (Vite) ---------------------------------------------------------
# Only VITE_* variables reach the browser. Both of these are meant to be public.
# Leave them empty and the app runs on this browser's fake data instead.
VITE_SUPABASE_URL=
# Project Settings > API Keys > Publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- optional -----------------------------------------------------------------
# Each time the API server starts it deletes designs and uploads that have been in Trash
# for over 30 days (backend/app/purge.py). Set this to 0 to turn that off.
# PURGE_ON_START=1
