{
  "_about": "Design tokens for the Canva-clone editor. Roles (what each colour does) are fixed; /replica-brand changes only the values. NOT measured from Canva: there are no screenshots, by design (public sources only), so these are a fresh system for a canvas editor built from the recon's screens and components. The accent is a neutral placeholder, not Canva's colours. After any change run: python contrast.py tokens.json, then python build_tokens.py tokens.json",
  "color": {
    "bg": "#ffffff",
    "surface": "#f4f5f7",
    "surface-hover": "#eceef1",
    "workspace": "#e6e8ec",
    "border": "#dfe2e6",
    "border-input": "#848c96",
    "text": "#15181d",
    "text-muted": "#59626d",
    "inverse": "#1d2127",
    "on-inverse": "#ffffff",
    "accent": "#2f5bea",
    "accent-hover": "#2448c2",
    "accent-soft": "#e8eefd",
    "on-accent": "#ffffff",
    "selection": "#2f5bea",
    "guide": "#d6246e",
    "danger": "#c62f2f",
    "on-danger": "#ffffff",
    "success": "#1f7a4d",
    "warning": "#8f5400"
  },
  "scrim": "rgba(16, 20, 26, 0.48)",
  "pairs": [
    ["text", "bg"],
    ["text", "surface"],
    ["text", "surface-hover"],
    ["text", "workspace"],
    ["text", "accent-soft"],
    ["text-muted", "bg"],
    ["text-muted", "surface"],
    ["text-muted", "surface-hover"],
    ["text-muted", "workspace"],
    ["on-inverse", "inverse"],
    ["on-accent", "accent"],
    ["on-accent", "accent-hover"],
    ["accent", "bg"],
    ["accent", "accent-soft"],
    ["on-danger", "danger"],
    ["danger", "bg"],
    ["danger", "surface-hover"],
    ["on-inverse", "guide"],
    ["success", "bg"],
    ["warning", "bg"],
    ["border-input", "bg", "ui"],
    ["border-input", "surface", "ui"],
    ["accent", "bg", "ui"],
    ["accent", "surface", "ui"],
    ["selection", "bg", "ui"],
    ["selection", "workspace", "ui"],
    ["guide", "bg", "ui"],
    ["guide", "workspace", "ui"]
  ],
  "font": {
    "sans": "\"Inter Variable\", Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
  },
  "type": {
    "xs": {"size": 12, "line": 16, "weight": 500},
    "sm": {"size": 14, "line": 20, "weight": 400},
