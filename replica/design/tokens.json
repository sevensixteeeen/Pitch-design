    "pop": "0 8px 24px rgba(16,24,40,.16)",
    "page": "0 2px 8px rgba(16,24,40,.12)"
  },
  "motion": {"fast": "120ms", "base": "200ms", "ease": "cubic-bezier(.2,.8,.2,1)"},
